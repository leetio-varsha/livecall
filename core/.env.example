# --- Whisper (local, whisper.cpp) ---
# whisper-server keeps the model resident in memory -> low per-chunk latency.
WHISPER_SERVER_BIN=~/whisper.cpp/build/bin/whisper-server
WHISPER_MODEL=~/whisper.cpp/models/ggml-large-v3.bin
# Silero VAD kills hallucinations on silence/pauses. Strongly recommended.
WHISPER_VAD_MODEL=~/whisper.cpp/models/ggml-silero-v5.1.2.bin
WHISPER_PORT=8178
# auto | ru | uk | en  (auto = per-chunk detection, needed for mixed calls)
WHISPER_LANG=auto
# If set, the core will NOT spawn its own server and will use this URL instead.
#WHISPER_SERVER_URL=http://127.0.0.1:8178

# --- LLM (the only remote call; transcript text only, never audio) ---
# auto = "api" when ANTHROPIC_API_KEY/ANTHROPIC_AUTH_TOKEN is set, else "claude-cli".
# api        - Anthropic API, streaming; meets the <2s first-token budget. Metered.
# claude-cli - reuses the local Claude Code login (subscription). No key needed,
#              but CLI startup adds ~2-4s -> misses the latency budget. Dev fallback.
LLM_BACKEND=auto
#ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# Model alias passed to the `claude` CLI fallback (aliases like sonnet/opus are safest).
LLM_CLI_MODEL=sonnet
CLAUDE_CLI_PATH=claude
# auto = answer in the language the question was asked in; or force ru | uk | en
ANSWER_LANG=auto

# FAST mode (Enter): instant crib for short factual questions.
# low effort + thinking disabled = fastest first token.
LLM_EFFORT=low
LLM_THINKING=disabled
LLM_MAX_TOKENS=1024

# DEEP mode (/deep): design / open-ended questions; quality over latency.
#DEEP_MODEL=claude-opus-5
DEEP_EFFORT=high
DEEP_THINKING=adaptive
DEEP_MAX_TOKENS=4096

# Prompt-cache lifetime: 1h | 5m. The cached prefix (pack + transcript + answers)
# is re-billed at full price every time it expires between presses. 1h writes
# cost 2x input instead of 1.25x but survive the pauses of a real call; 5m is
# a little cheaper for a short, dense session where you press every 2-3 min.
CACHE_TTL=1h

# Cross-provider fallback: used ONLY when the Anthropic attempt fails/times out
# (chain: anthropic -> openai -> claude-cli). Sends the same transcript text to
# OpenAI — set the key only if you're ok with that.
#OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
# none | low | medium | high; empty = omit the parameter (model default)
OPENAI_REASONING_EFFORT=
# Abort a provider attempt if its server sent no event within this many ms.
LLM_FIRST_EVENT_TIMEOUT_MS=6000

# --- Behavior ---
# "last N minutes" window highlighted to the model as the freshest context
ANSWER_WINDOW_MIN=3
# chunk size for file replay (live mode cuts at pauses instead)
CHUNK_SECONDS=5

# --- Live capture ---
#HELPER_PATH=../helper/build/livecall-helper
# Pause-based chunking: cut when >=MIN_SPEECH of speech is followed by
# >=SILENCE_MS of quiet (RMS < SILENCE_RMS), hard cap at MAX_CHUNK_MS.
SEGMENT_SILENCE_MS=600
SEGMENT_SILENCE_RMS=350
SEGMENT_MIN_SPEECH_MS=700
SEGMENT_MAX_CHUNK_MS=6000

# --- Global hotkeys ---
# Caught by the Swift helper, so they work while Zoom/Meet is in front. The
# combo is swallowed — the call app never sees it. Needs Accessibility +
# Input Monitoring (granted to Livecall.app, or to your terminal in CLI mode).
# Format: mods + one key, e.g. shift+opt+cmd+a. Mods: cmd opt shift ctrl.
# Two spec styles:
#   TAP   — a lone modifier pressed and released on its own: ropt, lopt, rcmd,
#           lcmd, rctrl (optionally shift+…). One key, nothing to reach for.
#           Never swallowed, so ⌥+letter symbol input keeps working, and it
#           only counts when nothing (key, click, scroll) happened in between
#           and it was held under 400ms.
#   COMBO — modifiers + a key: opt+cmd+a, shift+opt+cmd+a, f13. Swallowed, so
#           the call app never sees it.
HOTKEY_ENABLED=1
HOTKEY_FAST=ropt
HOTKEY_DEEP=shift+ropt
# "Answer about what's on my screen" — takes a silent screenshot and sends it
# WITH the question. Its own key on purpose: the picture is taken before the
# question goes out, so it costs a beat of latency you only want to pay when
# the answer actually depends on what is on screen.
HOTKEY_SCREEN=lopt

# What that screenshot aims at.
#   call            — the window of whatever app is holding the mic (default).
#                     A task shown to you is nearly always shared INTO the call
#                     window, so this is the tightest frame, it follows that
#                     window between monitors, and it keeps mail and Slack out
#                     of the picture. Falls back to the frontmost window, then
#                     to the main display, when no call window can be found.
#   front           — the frontmost window, whatever it is.
#   display         — the whole main display.
#   display:<name>  — a named screen, e.g. display:Studio. Matched on a
#                     substring of the display name, NOT on its ID: IDs are
#                     reassigned when you dock and undock, and a stored ID
#                     quietly starts pointing at the wrong screen.
# Livecall's own windows are always excluded, so the answer panel never ends up
# photographed inside the question.
SCREEN_TARGET=call

# Processes that hold the mic without being a call — a match must NOT start a
# new session (that would wipe the running Q&A memory mid-call). replayd,
# coreaudiod, corespeechd and Echo (a dictation app) are excluded already;
# add your own here.
#DETECT_EXCLUDE=Loom,Slack

# --- Telegram (answers pushed to your phone) ---
# A BOT, deliberately: the token can only post into chats the bot is already
# in, so a leak means "someone can message you" — not account access.
# 1. Talk to @BotFather → /newbot → copy the token here
# 2. Open your new bot and press Start (a bot cannot message you first)
# TELEGRAM_CHAT_ID is your own Telegram user id.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
# 1 = every answer goes to Telegram; 0 = only while silent mode is on
TELEGRAM_ALWAYS=1

# --- Call context ---
# Context (typed or attached from a PDF/text file) rides along in EVERY hotkey
# press for the rest of the call, so size costs money and latency. Prompt
# caching makes presses after the first cheap, but keep it to what matters.
# Anything longer is trimmed, with the app telling you how much was dropped.
CONTEXT_MAX_CHARS=60000

# --- Silent mode ---
# 1 = no answer panel on screen, answers go to Telegram only. Also togglable
# from the menu bar at any time.
SILENT_MODE=0

# --- Spend readout ---
# Anthropic list prices are built in. Neither Anthropic nor OpenAI exposes a
# "remaining balance" endpoint, so the menu shows what was actually spent
# (real token counts x rates) plus rate-limit headroom from response headers.
# Models without a built-in rate report tokens only — supply a rate to price
# them, in dollars per 1M tokens:
#PRICE_GPT_5_1_IN=
#PRICE_GPT_5_1_OUT=
#
# Optional: an Admin API key (sk-ant-admin01-...) adds Anthropic's own billed
# figure next to the local estimate. ORGANIZATION ACCOUNTS ONLY — the Admin API
# does not exist for individual accounts, and no endpoint on it reports
# remaining balance either. The local counter works regardless.
#ANTHROPIC_ADMIN_KEY=
